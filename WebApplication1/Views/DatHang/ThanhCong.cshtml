
@model WebApplication1.Models.DonHang

@{
    ViewBag.Title = "Đặt hàng thành công";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<style>
    .success-card {
        max-width: 850px;
        margin: 35px auto;
        background: white;
        border-radius: 20px;
        padding: 35px;
        box-shadow: 0 5px 25px rgba(0,0,0,.06);
    }

    .success-icon {
        width: 85px;
        height: 85px;
        background: #e5f7ec;
        color: #198754;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 42px;
        margin: 0 auto 20px;
    }

    .success-title {
        color: #198754;
        font-weight: 800;
    }

    .order-code {
        background: #f0f8f3;
        border: 1px dashed #198754;
        border-radius: 12px;
        padding: 15px;
        text-align: center;
        margin: 20px 0;
    }

        .order-code strong {
            color: #198754;
            font-size: 25px;
        }

    .order-info {
        background: #f8faf9;
        border-radius: 12px;
        padding: 18px;
    }
</style>

<div class="success-card">

    <div class="text-center">
        <div class="success-icon">
            <i class="fa-solid fa-check"></i>
        </div>

        <h2 class="success-title">Đặt hàng thành công!</h2>

        <p class="text-muted">
            Cảm ơn bạn đã mua sắm tại nhà thuốc của chúng tôi.
            Đơn hàng đã được ghi nhận và đang chờ xác nhận.
        </p>
    </div>

    <div class="order-code">
        <div class="text-muted mb-1">Mã đơn hàng của bạn</div>
        <strong>
            @("DH" + Model.MaDonHang.ToString("D5"))
        </strong>
    </div>

    <div class="order-info mb-4">
        <h5 class="fw-bold mb-3">Thông tin đơn hàng</h5>

        <div class="row mb-2">
            <div class="col-5 text-muted">Người nhận</div>
            <div class="col-7 fw-semibold">
                @Model.KhachHang.HoTen
            </div>
        </div>

        <div class="row mb-2">
            <div class="col-5 text-muted">Số điện thoại</div>
            <div class="col-7 fw-semibold">
                @Model.KhachHang.SoDienThoai
            </div>
        </div>

        <div class="row mb-2">
            <div class="col-5 text-muted">Địa chỉ giao hàng</div>
            <div class="col-7 fw-semibold">
                @Model.KhachHang.DiaChi
            </div>
        </div>

        <div class="row mb-2">
            <div class="col-5 text-muted">Ngày đặt</div>
            <div class="col-7 fw-semibold">
                @Model.NgayDat.ToString("dd/MM/yyyy HH:mm")
            </div>
        </div>

        <div class="row mb-2">
            <div class="col-5 text-muted">Trạng thái</div>
            <div class="col-7">
                <span class="badge bg-warning text-dark">
                    @Model.TrangThai
                </span>
            </div>
        </div>

        <div class="row">
            <div class="col-5 text-muted">Thanh toán</div>
            <div class="col-7 fw-semibold">
                Thanh toán khi nhận hàng (COD)
            </div>
        </div>
    </div>

    <h5 class="fw-bold mb-3">Sản phẩm đã đặt</h5>

    @foreach (var item in Model.ChiTietDonHangs)
    {
        <div class="d-flex justify-content-between align-items-center border-bottom py-3">
            <div>
                <div class="fw-bold">@item.Thuoc.TenThuoc</div>
                <small class="text-muted">
                    Số lượng: @item.SoLuong
                </small>
            </div>

            <strong class="text-success">
                @item.ThanhTien.Value.ToString("N0") đ
            </strong>
        </div>
    }

    <div class="d-flex justify-content-between mt-4">
        <span class="fw-bold">Tổng thanh toán</span>
        <span class="success-title fs-4">
            @Model.TongTien.ToString("N0") đ
        </span>
    </div>

    <div class="text-center mt-4">
        <a href="@Url.Action("Index", "Customer")"
           class="btn btn-success px-4 py-2">
            <i class="fa-solid fa-house me-2"></i>
            Tiếp tục mua sắm
        </a>
    </div>

</div>
