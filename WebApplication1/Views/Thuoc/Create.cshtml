
@model WebApplication1.Models.Thuoc

@{
    ViewBag.Title = "Thêm thuốc mới";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center flex-wrap mb-4">
        <div>
            <h2 class="fw-bold mb-1">Thêm thuốc mới</h2>
            <p class="text-muted mb-0">
                Nhập thông tin thuốc vào hệ thống quản lý quầy thuốc.
            </p>
        </div>

        <a href="@Url.Action("Index", "Thuoc")"
           class="btn btn-outline-secondary">
            <i class="fa-solid fa-arrow-left"></i>
            Quay lại
        </a>
    </div>
    @using (Html.BeginForm(
        "Create",
        "Thuoc",
        FormMethod.Post,
        new { enctype = "multipart/form-data" }))
    {
        @Html.AntiForgeryToken()

        @Html.ValidationSummary(false, "",
            new { @class = "alert alert-danger" })

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold">Thông tin cơ bản</h5>
            </div>

            <div class="card-body">
                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Tên thuốc <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.TenThuoc,
                            new
                                 {
                                @class = "form-control",
                                placeholder = "Nhập tên thuốc"
                            })
                        @Html.ValidationMessageFor(m => m.TenThuoc,
                            "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Danh mục <span class="text-danger">*</span></label>
                        @Html.DropDownListFor(m => m.MaDanhMuc,
                            (SelectList)ViewBag.MaDanhMuc,
                            "-- Chọn danh mục thuốc --",
                            new { @class = "form-select" })
                        @Html.ValidationMessageFor(m => m.MaDanhMuc,
                            "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Đơn vị tính <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.DonViTinh,
                            new
                                 {
                                @class = "form-control",
                                placeholder = "Ví dụ: Viên, hộp, vỉ"
                            })
                        @Html.ValidationMessageFor(m => m.DonViTinh,
                            "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Hoạt chất</label>
                        @Html.TextBoxFor(m => m.HoatChat,
                            new
                                 {
                                @class = "form-control",
                                placeholder = "Nhập hoạt chất"
                            })
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Hàm lượng</label>
                        @Html.TextBoxFor(m => m.HamLuong,
                            new
                                 {
                                @class = "form-control",
                                placeholder = "Ví dụ: 500 mg"
                            })
                    </div>

                    <!-- HÌNH ẢNH SẢN PHẨM -->
                    <div class="col-md-12 mb-3">

                        <label class="form-label fw-bold">
                            Hình ảnh sản phẩm
                        </label>

                        <input type="file"
                               name="anhFile"
                               id="anhFile"
                               class="form-control"
                               accept=".jpg,.jpeg,.png" />

                        <small class="text-muted">
                            Chỉ chấp nhận JPG, JPEG, PNG.
                            Dung lượng tối đa 2MB.
                        </small>

                        <div class="mt-3">
                            <img id="xemTruocAnh"
                                 src="#"
                                 alt="Xem trước hình ảnh thuốc"
                                 style="display:none;
                                        width:180px;
                                        height:180px;
                                        object-fit:contain;
                                        border:1px solid #ddd;
                                        border-radius:10px;
                                        padding:5px;" />
                        </div>

                        @Html.ValidationMessage(
                            "AnhThuoc",
                            "",
                            new { @class = "text-danger" }
                        )

                    </div>

                </div>
            </div>
        </div>


        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold">Thông tin giá và tồn kho</h5>
            </div>

            <div class="card-body">
                <div class="row">

                    <div class="col-md-4 mb-3">
                        <label class="form-label">Giá nhập (VNĐ) <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.GiaNhap,
                            new
                                 {
                                @class = "form-control",
                                type = "number",
                                min = "0",
                                step = "0.01"
                            })
                        @Html.ValidationMessageFor(m => m.GiaNhap,
                            "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-4 mb-3">
                        <label class="form-label">Giá bán (VNĐ) <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.GiaBan,
                            new
                                 {
                                @class = "form-control",
                                type = "number",
                                min = "0",
                                step = "0.01"
                            })
                        @Html.ValidationMessageFor(m => m.GiaBan,
                            "", new { @class = "text-danger" })
                    </div>

                    <div class="col-md-4 mb-3">
                        <label class="form-label">Mức tồn tối thiểu</label>
                        @Html.TextBoxFor(m => m.MucTonToiThieu,
                            new
                                 {
                                @class = "form-control",
                                type = "number",
                                min = "0"
                            })
                        @Html.ValidationMessageFor(m => m.MucTonToiThieu,
                            "", new { @class = "text-danger" })
                    </div>

                </div>

                <div class="alert alert-info mb-0">
                    <i class="fa-solid fa-circle-info"></i>
                    Thuốc mới được khởi tạo với số lượng tồn bằng 0.
                    Số lượng sẽ được cập nhật khi thực hiện nhập kho.
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 mb-4">
            <a href="@Url.Action("Index", "Thuoc")"
               class="btn btn-light border">
                Hủy
            </a>

            <button type="submit" class="btn btn-success px-4">
                <i class="fa-solid fa-floppy-disk"></i>
                Lưu thuốc
            </button>
        </div>
    }
</div>

<script>
    document.getElementById("anhFile").addEventListener("change", function () {

        var file = this.files[0];
        var anh = document.getElementById("xemTruocAnh");

        if (!file) {
            anh.style.display = "none";
            return;
        }

        var duoiFile = file.name.split('.').pop().toLowerCase();

        var dinhDangChoPhep = ["jpg", "jpeg", "png"];

        if (!dinhDangChoPhep.includes(duoiFile)) {
            alert("Vui lòng chọn ảnh JPG, JPEG hoặc PNG.");
            this.value = "";
            anh.style.display = "none";
            return;
        }

        if (file.size > 2 * 1024 * 1024) {
            alert("Dung lượng ảnh không được vượt quá 2MB.");
            this.value = "";
            anh.style.display = "none";
            return;
        }

        anh.src = URL.createObjectURL(file);
        anh.style.display = "block";
    });
</script>
