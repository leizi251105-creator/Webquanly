
@model WebApplication1.Models.TaiKhoan

@{
    ViewBag.Title = "Chỉnh sửa tài khoản";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid mt-4">

    <div class="card shadow-sm border-0">

        <div class="card-header bg-primary text-white py-3">
            <h4 class="mb-0">
                <i class="fa fa-user-edit"></i>
                Chỉnh sửa tài khoản nhân viên
            </h4>
        </div>

        <div class="card-body p-4">

            @using (Html.BeginForm("Edit", "TaiKhoan", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                @Html.HiddenFor(m => m.MaTaiKhoan)

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">
                            Mã tài khoản
                        </label>

                        <input type="text"
                               class="form-control"
                               value="TK@(Model.MaTaiKhoan.ToString("D5"))"
                               readonly />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">
                            Tên đăng nhập
                        </label>

                        @Html.TextBoxFor(m => m.TenDangNhap,
                            new
                                 {
                                @class = "form-control",
                                @readonly = "readonly"
                            })
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">
                            Họ và tên
                        </label>

                        @Html.TextBoxFor(m => m.HoTen,
                            new
                                 {
                                @class = "form-control",
                                required = "required"
                            })
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">
                            Email
                        </label>

                        @Html.TextBoxFor(m => m.Email,
                            new
                                 {
                                @class = "form-control",
                                type = "email"
                            })
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">
                            Số điện thoại
                        </label>

                        @Html.TextBoxFor(m => m.SoDienThoai,
                            new
                                 {
                                @class = "form-control"
                            })
                    </div>

                    <div class="col-md-6 mb-3">

                        <label class="form-label fw-bold d-block">
                            Trạng thái tài khoản
                        </label>

                        <div class="form-check form-switch mt-2">
                            @Html.CheckBoxFor(m => m.TrangThai,
                                new
                                     {
                                    @class = "form-check-input",
                                    role = "switch"
                                })

                            <label class="form-check-label">
                                Đang hoạt động
                            </label>
                        </div>

                    </div>

                </div>

                <hr />

                <div class="d-flex justify-content-between">

                    <a href="@Url.Action("Index", "TaiKhoan")"
                       class="btn btn-secondary">
                        <i class="fa fa-arrow-left"></i>
                        Quay lại
                    </a>

                    <button type="submit" class="btn btn-primary">
                        <i class="fa fa-save"></i>
                        Lưu thay đổi
                    </button>

                </div>
            }

        </div>
    </div>

</div>
