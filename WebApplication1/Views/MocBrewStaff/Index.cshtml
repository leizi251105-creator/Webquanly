
@model IEnumerable<WebApplication1.Controllers.MocBrewStaffController.StaffListItem>

@{
    ViewBag.Title = "Quản lý nhân viên";
    Layout = null;

    int totalStaff = Model == null ? 0 : Model.Count();
    int activeStaff = Model == null ? 0 : Model.Count(x => x.IsActive);
    int lockedStaff = totalStaff - activeStaff;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Quản lý nhân viên - MỘC BREW</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
          rel="stylesheet" />

    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Roboto:wght@400;500;700&display=swap"
          rel="stylesheet" />

    <style>
        body {
            margin: 0;
            background: #f6f2eb;
            font-family: 'Roboto', sans-serif;
            color: #3b3029;
        }

        .sidebar {
            width: 245px;
            min-height: 100vh;
            background: #35251e;
            color: white;
            position: fixed;
            padding: 28px 18px;
        }

        .brand {
            font-family: 'Playfair Display', serif;
            font-size: 27px;
            text-align: center;
            margin-bottom: 8px;
        }

        .brand-sub {
            text-align: center;
            color: #cbb9a7;
            font-size: 11px;
            letter-spacing: 3px;
            margin-bottom: 38px;
        }

        .sidebar a {
            display: block;
            color: #e9ddd2;
            text-decoration: none;
            padding: 13px 14px;
            border-radius: 9px;
            margin-bottom: 8px;
        }

            .sidebar a.active,
            .sidebar a:hover {
                background: #79543d;
                color: white;
            }

        .main {
            margin-left: 245px;
            padding: 35px;
        }

        .page-title {
            font-family: 'Playfair Display', serif;
            font-weight: 700;
            color: #493326;
        }

        .stat-card {
            background: white;
            border: 0;
            border-radius: 14px;
            padding: 22px;
            box-shadow: 0 4px 16px rgba(60, 40, 25, .05);
            height: 100%;
        }

        .stat-number {
            font-size: 27px;
            font-weight: 700;
            margin-top: 10px;
        }

        .staff-table {
            background: white;
            border-radius: 14px;
            overflow: hidden;
            box-shadow: 0 4px 16px rgba(60, 40, 25, .05);
        }

            .staff-table th {
                background: #493326;
                color: white;
                font-weight: 500;
                white-space: nowrap;
                padding: 16px;
            }

            .staff-table td {
                padding: 15px;
                vertical-align: middle;
            }

        .btn-coffee {
            background: #79543d;
            color: white;
            border: none;
        }

            .btn-coffee:hover {
                background: #5d3e2d;
                color: white;
            }

        .status-active {
            background: #e2f3e8;
            color: #237342;
        }

        .status-locked {
            background: #fce8e6;
            color: #b3261e;
        }

        @@media (max-width: 768px) {
            .sidebar {
                width: 100%;
                min-height: auto;
                position: relative;
            }

            .main {
                margin-left: 0;
                padding: 20px;
            }
        }
    </style>
</head>

<body>

    <aside class="sidebar">
        <div class="brand">MỘC BREW</div>
        <div class="brand-sub">COFFEE MANAGEMENT</div>

        <a href="@Url.Action("Index", "MocBrewDashboard")">
            <i class="fa-solid fa-house me-2"></i> Tổng quan
        </a>

        <a href="#" class="active">
            <i class="fa-solid fa-users me-2"></i> Quản lý nhân viên
        </a>

        <button type="button" class="btn btn-coffee px-4" disabled>
            <i class="fa-solid fa-plus me-2"></i>
            Thêm nhân viên
        </button>

        <hr class="border-secondary" />

        @using (Html.BeginForm("Logout", "MocBrewAuth", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <button type="submit" class="btn btn-outline-light w-100 mt-2">
                <i class="fa-solid fa-right-from-bracket me-2"></i>
                Đăng xuất
            </button>
        }
    </aside>

    <main class="main">

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
            <div>
                <h2 class="page-title mb-1">Quản lý nhân viên</h2>
                <div class="text-secondary">
                    Quản lý tài khoản và thông tin nhân viên MỘC BREW
                </div>
            </div>

            <a href="@Url.Action("Create", "MocBrewStaff")"
               class="btn btn-coffee px-4">
                <i class="fa-solid fa-plus me-2"></i>
                Thêm nhân viên
            </a>

        <div class="row g-3 mb-4">

            <div class="col-md-4">
                <div class="stat-card">
                    <div class="text-secondary">Tổng nhân viên</div>
                    <div class="stat-number">@totalStaff</div>
                    <i class="fa-solid fa-users text-secondary"></i>
                </div>
            </div>

            <div class="col-md-4">
                <div class="stat-card">
                    <div class="text-secondary">Đang hoạt động</div>
                    <div class="stat-number text-success">@activeStaff</div>
                    <i class="fa-solid fa-user-check text-success"></i>
                </div>
            </div>

            <div class="col-md-4">
                <div class="stat-card">
                    <div class="text-secondary">Đã khóa</div>
                    <div class="stat-number text-danger">@lockedStaff</div>
                    <i class="fa-solid fa-user-lock text-danger"></i>
                </div>
            </div>

        </div>

        <div class="staff-table">

            <div class="p-3 border-bottom">
                <h5 class="mb-0 fw-bold">Danh sách tài khoản nhân viên</h5>
                <small class="text-secondary">
                    Danh sách nhân viên có vai trò Staff
                </small>
            </div>

            <div class="table-responsive">

                <table class="table table-hover mb-0">

                    <thead>
                        <tr>
                            <th>Mã nhân viên</th>
                            <th>Họ và tên</th>
                            <th>Tên đăng nhập</th>
                            <th>Email</th>
                            <th>Số điện thoại</th>
                            <th>Trạng thái</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var staff in Model)
                            {
                                <tr>
                                    <td class="fw-bold">
                                        @(staff.EmployeeCode ?? "Chưa có")
                                    </td>

                                    <td>@staff.FullName</td>

                                    <td>@staff.Username</td>

                                    <td>@(staff.Email ?? "Chưa cập nhật")</td>

                                    <td>@(staff.Phone ?? "Chưa cập nhật")</td>

                                    <td>
                                        @if (staff.IsActive)
                                        {
                                            <span class="badge status-active px-3 py-2">
                                                Đang hoạt động
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge status-locked px-3 py-2">
                                                Đã khóa
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5">
                                    <i class="fa-solid fa-users-slash fa-2x text-secondary mb-3"></i>

                                    <div class="fw-bold">
                                        Chưa có tài khoản nhân viên
                                    </div>

                                    <div class="text-secondary small">
                                        Danh sách sẽ hiển thị sau khi Manager tạo tài khoản Staff.
                                    </div>
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        </div>

        <div class="text-secondary small mt-3">
            <i class="fa-solid fa-shield-halved me-1"></i>
            Chỉ tài khoản Manager có quyền STAFF_MANAGE mới được truy cập chức năng này.
        </div>

    </main>

</body>
</html>
