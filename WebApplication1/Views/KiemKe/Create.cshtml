
@model WebApplication1.Models.KiemKeViewModel

@{
    ViewBag.Title = "Lập phiếu kiểm kê";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2>Lập phiếu kiểm kê</h2>
            <p class="text-muted">
                Nhập số lượng thực tế của từng lô thuốc trong kho.
            </p>
        </div>

        <a href="@Url.Action("Index", "KiemKe")"
           class="btn btn-outline-secondary">
            Quay lại
        </a>
    </div>

    @using (Html.BeginForm("Create", "KiemKe", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        @Html.ValidationSummary(false, "", new { @class = "alert alert-danger" })

        <div class="card mb-3">
            <div class="card-body">
                <label for="GhiChu" class="form-label">Ghi chú</label>
                @Html.TextAreaFor(
                    m => m.GhiChu,
                    new
                    {
                        @class = "form-control",
                        rows = 2,
                        placeholder = "Nhập ghi chú kiểm kê nếu có..."
                    })
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <strong>Danh sách lô thuốc</strong>
            </div>

            <div class="table-responsive">
                <table class="table table-bordered table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Mã lô</th>
                            <th>Tên thuốc</th>
                            <th>Số lô</th>
                            <th>Hạn sử dụng</th>
                            <th>Tồn hệ thống</th>
                            <th style="min-width: 150px;">
                                Số lượng thực tế
                            </th>
                            <th>Chênh lệch dự kiến</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.ChiTiet == null || !Model.ChiTiet.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted p-4">
                                    Không có lô thuốc đang còn tồn để kiểm kê.
                                </td>
                            </tr>
                        }
                        else
                        {
                            for (int i = 0; i < Model.ChiTiet.Count; i++)
                            {
                                <tr>
                                    <td>
                                        @Model.ChiTiet[i].MaLo
                                        @Html.HiddenFor(m => m.ChiTiet[i].MaLo)
                                    </td>

                                    <td>
                                        @Model.ChiTiet[i].TenThuoc
                                        @Html.HiddenFor(m => m.ChiTiet[i].TenThuoc)
                                    </td>

                                    <td>
                                        @Model.ChiTiet[i].SoLo
                                        @Html.HiddenFor(m => m.ChiTiet[i].SoLo)
                                    </td>

                                    <td>
                                        @Model.ChiTiet[i].HanSuDung
                                        @Html.HiddenFor(m => m.ChiTiet[i].HanSuDung)
                                    </td>

                                    <td>
                                        @Model.ChiTiet[i].SoLuongHeThong
                                        @Html.HiddenFor(m => m.ChiTiet[i].SoLuongHeThong)
                                    </td>

                                    <td>
                                        @Html.TextBoxFor(
                                            m => m.ChiTiet[i].SoLuongThucTe,
                                            new
                                            {
                                                @class = "form-control so-luong-thuc-te",
                                                type = "number",
                                                min = "0",
                                                required = "required"
                                            })

                                        @Html.ValidationMessageFor(
                                            m => m.ChiTiet[i].SoLuongThucTe,
                                            "",
                                            new { @class = "text-danger" })
                                    </td>

                                    <td class="chenh-lech fw-bold">0</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="mt-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary">
                Lưu phiếu kiểm kê
            </button>

            <a href="@Url.Action("Index", "KiemKe")"
               class="btn btn-outline-secondary">
                Hủy
            </a>
        </div>
    }
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const rows = document.querySelectorAll("tbody tr");

        rows.forEach(function (row) {
            const input = row.querySelector(".so-luong-thuc-te");
            const output = row.querySelector(".chenh-lech");

            if (!input || !output) return;

            const cells = row.querySelectorAll("td");
            const tonHeThong = parseInt(cells[4].innerText.trim(), 10) || 0;

            function capNhatChenhLech() {
                const thucTe = parseInt(input.value, 10) || 0;
                const chenhLech = thucTe - tonHeThong;

                output.textContent =
                    chenhLech > 0 ? "+" + chenhLech : chenhLech;
            }

            input.addEventListener("input", capNhatChenhLech);
            capNhatChenhLech();
        });
    });
</script>
