
@model List<WebApplication1.Models.ViewModels.GioHangItemViewModel>

@{
    ViewBag.Title = "Giỏ hàng";
    Layout = "~/Views/Shared/_CustomerLayout.cshtml";
}

<style>
    .cart-page {
        padding: 30px 0 55px;
    }

    .cart-heading {
        color: #174d3b;
        font-weight: 800;
        margin-bottom: 25px;
    }

    .cart-card {
        background: #fff;
        border-radius: 14px;
        padding: 22px;
        box-shadow: 0 4px 18px rgba(0,0,0,.06);
    }

    .cart-table th {
        background: #f3f8f5;
        color: #315c49;
        white-space: nowrap;
    }

    .cart-image {
        width: 75px;
        height: 75px;
        background: #f5faf7;
        border-radius: 10px;
        padding: 5px;
        object-fit: contain;
    }

    .cart-placeholder {
        width: 75px;
        height: 75px;
        background: #f5faf7;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #26966c;
        font-size: 30px;
    }

    .quantity-input {
        width: 85px;
        text-align: center;
    }

    .cart-total {
        font-size: 25px;
        font-weight: 800;
        color: #dc3545;
    }

    .cart-summary {
        background: #f5faf7;
        padding: 22px;
        border-radius: 12px;
    }

    .empty-cart {
        text-align: center;
        padding: 65px 20px;
    }

        .empty-cart i {
            font-size: 70px;
            color: #a8cdbb;
            margin-bottom: 20px;
        }

    @@media (max-width: 768px) {
        .cart-card {
            padding: 12px;
        }

        .cart-table {
            min-width: 700px;
        }
    }
</style>

<div class="cart-page">

    <h2 class="cart-heading">
        <i class="fa-solid fa-cart-shopping me-2"></i>
        Giỏ hàng của bạn
    </h2>

    @if (TempData["ThongBao"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["ThongBao"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ThongBaoLoi"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["ThongBaoLoi"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="row g-4">

            <!-- DANH SÁCH SẢN PHẨM -->
            <div class="col-lg-8">

                <div class="cart-card">

                    <div class="table-responsive">
                        <table class="table align-middle cart-table">

                            <thead>
                                <tr>
                                    <th>Sản phẩm</th>
                                    <th>Đơn giá</th>
                                    <th>Số lượng</th>
                                    <th>Thành tiền</th>
                                    <th></th>
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var item in Model)
                                {
                                    <tr>

                                        <td>
                                            <div class="d-flex align-items-center gap-3">

                                                @if (!string.IsNullOrEmpty(item.AnhThuoc))
                                                {
                                                    <img src="@Url.Content(item.AnhThuoc)"
                                                         class="cart-image"
                                                         alt="@item.TenThuoc" />
                                                }
                                                else
                                                {
                                                    <div class="cart-placeholder">
                                                        <i class="fa-solid fa-capsules"></i>
                                                    </div>
                                                }

                                                <div>
                                                    <div class="fw-bold">
                                                        @item.TenThuoc
                                                    </div>
                                                    <small class="text-muted">
                                                        Đơn vị: @item.DonViTinh
                                                    </small>
                                                </div>

                                            </div>
                                        </td>

                                        <td class="fw-semibold">
                                            @String.Format("{0:N0} đ", item.DonGia)
                                        </td>

                                        <td>
                                            @using (Html.BeginForm("CapNhat", "GioHang",
                                                FormMethod.Post))
                                            {
                                                @Html.Hidden("id", item.MaThuoc)

                                                <div class="d-flex align-items-center gap-2">
                                                    <input type="number"
                                                           name="soLuong"
                                                           value="@item.SoLuong"
                                                           min="1"
                                                           max="@item.SoLuongTon"
                                                           class="form-control quantity-input" />

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-success"
                                                            title="Cập nhật số lượng">
                                                        <i class="fa-solid fa-rotate"></i>
                                                    </button>
                                                </div>
                                            }
                                        </td>

                                        <td class="fw-bold text-danger">
                                            @String.Format("{0:N0} đ", item.ThanhTien)
                                        </td>

                                        <td>
                                            <a href="@Url.Action("Xoa", "GioHang",
                                                new { id = item.MaThuoc })"
                                               class="btn btn-sm btn-outline-danger"
                                               onclick="return confirm('Bạn có chắc chắn muốn xóa sản phẩm này?');"
                                               title="Xóa sản phẩm">
                                                <i class="fa-solid fa-trash"></i>
                                            </a>
                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>
                    </div>

                    <div class="mt-3">
                        <a href="@Url.Action("Index", "SanPham")"
                           class="btn btn-outline-success">
                            <i class="fa-solid fa-arrow-left me-2"></i>
                            Tiếp tục mua sắm
                        </a>
                    </div>

                </div>

            </div>

            <!-- TỔNG THANH TOÁN -->
            <div class="col-lg-4">

                <div class="cart-summary">

                    <h5 class="fw-bold mb-4">Thông tin đơn hàng</h5>

                    <div class="d-flex justify-content-between mb-3">
                        <span>Tổng số lượng:</span>
                        <strong>@ViewBag.TongSoLuong sản phẩm</strong>
                    </div>

                    <div class="d-flex justify-content-between mb-3">
                        <span>Tạm tính:</span>
                        <strong class="cart-total">
                            @String.Format("{0:N0} đ", ViewBag.TongTien)
                        </strong>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <span class="fw-bold">Tổng cộng:</span>
                        <span class="cart-total">
                            @String.Format("{0:N0} đ", ViewBag.TongTien)
                        </span>
                    </div>

                    <a href="@Url.Action("Index", "DatHang")"
                       class="btn btn-success btn-lg w-100">
                        <i class="fa-solid fa-cart-shopping me-2"></i>
                        Tiến hành đặt hàng
                    </a>

                    <p class="text-muted small mt-3 mb-0">
                        Giá trị đơn hàng được tính theo giá bán
                        của từng sản phẩm.
                    </p>

                </div>

            </div>

        </div>
    }
    else
    {
        <div class="cart-card empty-cart">

            <i class="fa-solid fa-cart-shopping"></i>

            <h4 class="fw-bold">Giỏ hàng đang trống</h4>

            <p class="text-muted">
                Bạn chưa thêm sản phẩm nào vào giỏ hàng.
            </p>

            <a href="@Url.Action("Index", "SanPham")"
               class="btn btn-success px-4 py-2">
                Khám phá sản phẩm
            </a>

        </div>
    }

</div>

