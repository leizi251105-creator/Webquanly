
@model IEnumerable<WebApplication1.Models.PhieuNhap>

@{
    ViewBag.Title = "Lịch sử nhập hàng";
    decimal tongGiaTri = ViewBag.TongGiaTri ?? 0m;
    int tongSoPhieu = ViewBag.TongSoPhieu ?? 0;
}

<style>
    .history-page {
        padding: 20px 5px;
    }

    .history-header {
        background: linear-gradient(135deg, #0d6efd, #2457a7);
        color: white;
        padding: 25px 30px;
        border-radius: 14px;
        margin-bottom: 22px;
    }

    .history-stat {
        background: white;
        padding: 20px;
        border-radius: 12px;
        box-shadow: 0 3px 15px rgba(0,0,0,.06);
        height: 100%;
    }

        .history-stat .stat-label {
            color: #64748b;
            font-size: 13px;
        }

        .history-stat .stat-value {
            font-size: 23px;
            font-weight: 700;
            color: #1e293b;
            margin-top: 8px;
        }

    .history-filter {
        background: white;
        padding: 20px;
        border-radius: 12px;
        box-shadow: 0 3px 15px rgba(0,0,0,.05);
        margin-bottom: 20px;
    }

    .history-table {
        background: white;
        border-radius: 12px;
        padding: 20px;
        box-shadow: 0 3px 15px rgba(0,0,0,.05);
    }

        .history-table table {
            vertical-align: middle;
        }

        .history-table thead th {
            background: #f1f5f9;
            color: #475569;
            white-space: nowrap;
        }

    .money {
        color: #0d6efd;
        font-weight: 700;
        white-space: nowrap;
    }
</style>

<div class="history-page">

    <!-- TIÊU ĐỀ -->
    <div class="history-header">
        <h3 class="mb-2">
            <i class="fa-solid fa-clock-rotate-left me-2"></i>
            Lịch sử nhập hàng
        </h3>

        <div>
            Nhà cung cấp:
            <strong>@ViewBag.TenNhaCungCap</strong>
        </div>

        <div class="mt-1">
            Mã nhà cung cấp:
            <strong>NCC@(Convert.ToInt32(ViewBag.MaNhaCungCap).ToString("D4"))</strong>        </div>
    </div>

    <!-- THỐNG KÊ -->
    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="history-stat">
                <div class="stat-label">
                    <i class="fa-solid fa-file-invoice me-1"></i>
                    Tổng số phiếu nhập
                </div>
                <div class="stat-value">@tongSoPhieu</div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="history-stat">
                <div class="stat-label">
                    <i class="fa-solid fa-money-bill-wave me-1"></i>
                    Tổng giá trị nhập hàng
                </div>
                <div class="stat-value text-primary">
                    @tongGiaTri.ToString("N0") đ
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="history-stat">
                <div class="stat-label">
                    <i class="fa-solid fa-calendar-check me-1"></i>
                    Phiếu nhập gần nhất
                </div>
                <div class="stat-value">
                    @if (ViewBag.PhieuGanNhat != null)
                    {
                        @(((DateTime)ViewBag.PhieuGanNhat).ToString("dd/MM/yyyy"))
                    }
                    else
                    {
                        <span class="text-muted">Chưa có dữ liệu</span>
                    }
                </div>
            </div>
        </div>

    </div>

    <!-- BỘ LỌC -->
    <div class="history-filter">

        <form method="get"
              action="@Url.Action("LichSuNhapHang", "NhaCungCap")">

            <input type="hidden"
                   name="id"
                   value="@ViewBag.MaNhaCungCap" />

            <div class="row g-3 align-items-end">

                <div class="col-md-4">
                    <label class="form-label fw-semibold">
                        Tìm kiếm
                    </label>
                    <input type="text"
                           name="tuKhoa"
                           class="form-control"
                           value="@ViewBag.TuKhoa"
                           placeholder="Mã phiếu hoặc ghi chú..." />
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-semibold">
                        Từ ngày
                    </label>
                    <input type="date"
                           name="tuNgay"
                           class="form-control"
                           value="@ViewBag.TuNgay" />
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-semibold">
                        Đến ngày
                    </label>
                    <input type="date"
                           name="denNgay"
                           class="form-control"
                           value="@ViewBag.DenNgay" />
                </div>

                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </button>

                    <a href="@Url.Action("LichSuNhapHang", "NhaCungCap", new { id = ViewBag.MaNhaCungCap })"
                       class="btn btn-outline-secondary">
                        <i class="fa-solid fa-rotate-left"></i>
                    </a>
                </div>

            </div>
        </form>

    </div>

    <!-- DANH SÁCH PHIẾU NHẬP -->
    <div class="history-table">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold mb-0">
                Danh sách phiếu nhập
            </h5>

            <span class="text-muted">
                @tongSoPhieu phiếu nhập
            </span>
        </div>

        <div class="table-responsive">

            <table class="table table-hover">

                <thead>
                    <tr>
                        <th>Mã phiếu</th>
                        <th>Ngày nhập</th>
                        <th>Người lập phiếu</th>
                        <th>Ghi chú</th>
                        <th class="text-end">Tổng tiền</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        foreach (var phieu in Model)
                        {
                            <tr>
                                <td class="fw-bold text-primary">
                                    PN@phieu.MaPhieuNhap.ToString("D4")
                                </td>

                                <td>
                                    @phieu.NgayNhap.ToString("dd/MM/yyyy HH:mm")
                                </td>

                                <td>
                                    @(phieu.TaiKhoan != null
                                        ? phieu.TaiKhoan.TenDangNhap
                                        : "Không xác định")
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(phieu.GhiChu)
                                        ? "Không có ghi chú"
                                        : phieu.GhiChu)
                                </td>

                                <td class="text-end money">
                                    @((phieu.TongTien ?? 0m).ToString("N0")) đ
                                </td>

                                <td class="text-center">
                                    <a href="@Url.Action("Details", "NhapHang", new { id = phieu.MaPhieuNhap })"
                                       class="btn btn-sm btn-outline-primary"
                                       title="Xem chi tiết phiếu nhập">
                                        <i class="fa-solid fa-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <i class="fa-solid fa-folder-open fa-2x text-muted mb-2"></i>
                                <p class="text-muted mb-0">
                                    Nhà cung cấp chưa có phiếu nhập nào phù hợp.
                                </p>
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

        <div class="mt-3">
            <a href="@Url.Action("Details", "NhaCungCap", new { id = ViewBag.MaNhaCungCap })"
               class="btn btn-outline-secondary">
                <i class="fa-solid fa-arrow-left me-1"></i>
                Quay lại nhà cung cấp
            </a>
        </div>

    </div>

</div>
