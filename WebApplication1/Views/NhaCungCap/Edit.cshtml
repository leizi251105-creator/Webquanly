
@model WebApplication1.Models.NhaCungCap

@{
    ViewBag.Title = "Chỉnh sửa nhà cung cấp";
}

<style>
    .supplier-page {
        max-width: 900px;
        margin: 25px auto;
    }

    .supplier-header {
        background: linear-gradient(135deg, #0d6efd, #2457a7);
        color: white;
        padding: 25px 30px;
        border-radius: 14px 14px 0 0;
    }

    .supplier-card {
        background: white;
        padding: 30px;
        border-radius: 0 0 14px 14px;
        box-shadow: 0 5px 20px rgba(0,0,0,.07);
    }

    .form-label {
        font-weight: 600;
        color: #334155;
    }

    .form-control {
        border-radius: 8px;
        padding: 10px 12px;
    }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 25px;
    }
</style>

<div class="supplier-page">

    <div class="supplier-header">
        <h3 class="mb-1">
            <i class="fa-solid fa-pen-to-square me-2"></i>
            Chỉnh sửa nhà cung cấp
        </h3>
        <p class="mb-0">
            Cập nhật thông tin nhà cung cấp trong hệ thống
        </p>
    </div>

    <div class="supplier-card">

        @using (Html.BeginForm("Edit", "NhaCungCap", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.MaNhaCungCap)

            @Html.ValidationSummary(false, "", new { @class = "text-danger mb-3" })

            <div class="mb-3">
                <label class="form-label">Tên nhà cung cấp <span class="text-danger">*</span></label>
                @Html.TextBoxFor(m => m.TenNhaCungCap,
                    new { @class = "form-control", placeholder = "Nhập tên nhà cung cấp" })
                @Html.ValidationMessageFor(m => m.TenNhaCungCap, "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                <label class="form-label">Địa chỉ</label>
                @Html.TextBoxFor(m => m.DiaChi,
                    new { @class = "form-control", placeholder = "Nhập địa chỉ" })
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Số điện thoại</label>
                    @Html.TextBoxFor(m => m.SoDienThoai,
                        new { @class = "form-control", placeholder = "Nhập số điện thoại" })
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Email</label>
                    @Html.TextBoxFor(m => m.Email,
                        new { @class = "form-control", placeholder = "Nhập email" })
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label">Mã số thuế</label>
                @Html.TextBoxFor(m => m.MaSoThue,
                    new { @class = "form-control", placeholder = "Nhập mã số thuế" })
            </div>

            <div class="form-check form-switch mt-3">

                @if (Model.TrangThai == true)
                {
                    <input type="checkbox"
                           name="TrangThai"
                           id="TrangThai"
                           value="true"
                           class="form-check-input"
                           checked="checked" />
                }
                else
                {
                    <input type="checkbox"
                           name="TrangThai"
                           id="TrangThai"
                           value="true"
                           class="form-check-input" />
                }

                <input type="hidden"
                       name="TrangThai"
                       value="false" />

                <label class="form-check-label" for="TrangThai">
                    Đang hoạt động
                </label>

            </div>

            <div class="form-actions">
                <a href="@Url.Action("Index", "NhaCungCap")"
                   class="btn btn-outline-secondary">
                    <i class="fa-solid fa-arrow-left me-1"></i>
                    Quay lại
                </a>

                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-floppy-disk me-1"></i>
                    Lưu thay đổi
                </button>
            </div>
        }
    </div>
</div>
