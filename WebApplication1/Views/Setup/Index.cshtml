
@model WebApplication1.Controllers.SetupController.SetupViewModel

@{
    Layout = null;
    ViewBag.Title = "Khởi tạo MỘC BREW";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Khởi tạo tài khoản - MỘC BREW</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <style>
        body {
            min-height: 100vh;
            background: linear-gradient(135deg, #173c32, #315e49);
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: Arial, sans-serif;
            padding: 20px;
        }

        .setup-card {
            width: 100%;
            max-width: 480px;
            background: white;
            border-radius: 18px;
            padding: 35px;
            box-shadow: 0 15px 45px rgba(0,0,0,.2);
        }

        .brand {
            color: #24543d;
            font-weight: bold;
            letter-spacing: 3px;
            text-align: center;
        }

        .btn-moc {
            background: #24543d;
            color: white;
            width: 100%;
            padding: 12px;
            font-weight: bold;
        }

            .btn-moc:hover {
                background: #173c32;
                color: white;
            }
    </style>
</head>

<body>

    <div class="setup-card">

        <h2 class="brand">MỘC BREW</h2>

        <p class="text-center text-muted mb-4">
            KHỞI TẠO TÀI KHOẢN QUẢN LÝ
        </p>

        <div class="alert alert-info">
            Đây là bước tạo tài khoản Manager đầu tiên
            cho hệ thống cửa hàng.
        </div>

        @using (Html.BeginForm("Index", "Setup", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            @Html.ValidationSummary(false, "", new { @class = "text-danger mb-3" })

            <div class="mb-3">
                <label class="form-label">Họ và tên</label>
                @Html.TextBoxFor(m => m.FullName,
                         new { @class = "form-control", placeholder = "Nhập họ và tên" })
                @Html.ValidationMessageFor(m => m.FullName,
                         "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                <label class="form-label">Tên đăng nhập</label>
                @Html.TextBoxFor(m => m.Username,
                         new { @class = "form-control", placeholder = "Nhập tên đăng nhập" })
                @Html.ValidationMessageFor(m => m.Username,
                         "", new { @class = "text-danger" })
            </div>

            <div class="mb-3">
                <label class="form-label">Mật khẩu</label>
                @Html.PasswordFor(m => m.Password,
                         new { @class = "form-control", placeholder = "Ít nhất 12 ký tự" })
                @Html.ValidationMessageFor(m => m.Password,
                         "", new { @class = "text-danger" })
            </div>

            <div class="mb-4">
                <label class="form-label">Xác nhận mật khẩu</label>
                @Html.PasswordFor(m => m.ConfirmPassword,
                         new { @class = "form-control", placeholder = "Nhập lại mật khẩu" })
                @Html.ValidationMessageFor(m => m.ConfirmPassword,
                         "", new { @class = "text-danger" })
            </div>

            <button type="submit" class="btn btn-moc">
                TẠO TÀI KHOẢN MANAGER
            </button>
        }

        <p class="text-center text-muted mt-4 mb-0">
            MỘC BREW MANAGEMENT SYSTEM
        </p>

    </div>

</body>
</html>
