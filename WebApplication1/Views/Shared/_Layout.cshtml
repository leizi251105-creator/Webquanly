<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Quản Lý Quầy Thuốc</title>

    <!-- Thư viện Bootstrap 5 & FontAwesome CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet">

    <style>
        :root {
            --sidebar-bg: #1e293b;
            --sidebar-hover: #334155;
            --sidebar-text: #cbd5e1;
            --sidebar-active: #2563eb;
            --header-bg: #ffffff;
            --body-bg: #f8fafc;
        }

        body {
            background-color: var(--body-bg);
            font-family: 'Segoe UI', Arial, sans-serif;
            margin: 0;
            padding: 0;
        }

        /* Top Bar Header */
        .top-navbar {
            background-color: var(--header-bg);
            border-bottom: 1px solid #e2e8f0;
            height: 60px;
        }

        /* Sidebar Navigation */
        .sidebar {
            width: 250px;
            background-color: var(--sidebar-bg);
            min-height: calc(100vh - 60px);
            flex-shrink: 0;
        }

        .sidebar-brand {
            padding: 16px 20px;
            font-size: 1.1rem;
            font-weight: 700;
            color: #ffffff;
            border-bottom: 1px solid #334155;
            letter-spacing: 0.5px;
        }

        .sidebar-nav {
            padding: 10px 0;
        }

            .sidebar-nav .nav-link {
                color: var(--sidebar-text);
                padding: 12px 20px;
                font-size: 0.95rem;
                display: flex;
                align-items: center;
                gap: 12px;
                transition: all 0.2s ease;
                text-decoration: none;
            }

                .sidebar-nav .nav-link:hover {
                    background-color: var(--sidebar-hover);
                    color: #ffffff;
                }

                .sidebar-nav .nav-link.active {
                    background-color: var(--sidebar-active);
                    color: #ffffff;
                }

            .sidebar-nav .nav-link-logout {
                color: #f87171;
            }

                .sidebar-nav .nav-link-logout:hover {
                    background-color: #991b1b;
                    color: #ffffff;
                }

        /* Main Content */
        .main-wrapper {
            flex-grow: 1;
            padding: 24px;
        }
    </style>
</head>
<body>

    <!-- Header Trên Cùng -->
    <header class="top-navbar d-flex align-items-center justify-content-between px-4 sticky-top shadow-sm">
        <div class="fw-bold text-primary fs-5">
            <i class="fa-solid fa-clinic-medical me-2"></i>QUẦY THUỐC
        </div>

        <div class="d-flex align-items-center gap-3">
            <span class="fw-semibold text-dark">
                @(Session["fullName"] != null
            ? Session["fullName"].ToString()
            : Session["username"] != null
                ? Session["username"].ToString()
                : "Người dùng")
            </span>

            <a href="#" class="text-secondary fs-5 position-relative text-decoration-none">
                <i class="fa-solid fa-bell"></i>
                <span class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle"></span>
            </a>
        </div>

    </header>

    <!-- Thân Trông Gồm Sidebar + Nội Dung -->
    <div class="d-flex">
        <!-- Sidebar Bên Trái -->
        <aside class="sidebar shadow-sm">
            <div class="sidebar-brand">
                <i class="fa-solid fa-pills me-2 text-warning"></i>QUẦY THUỐC
            </div>
            <nav class="sidebar-nav">
                <a href="@Url.Action("Index", "Admin")" class="nav-link active">
                    <i class="fa-solid fa-house"></i> Trang chủ
                </a>
                <a href="@Url.Action("Index", "Admin")" class="nav-link">
                    <i class="fa-solid fa-gear"></i> Quản trị

                    <nav class="sidebar-menu">

                        <a href="@Url.Action("Index", "Kho")" class="nav-link">
                            <i class="fa-solid fa-boxes-stacked"></i>
                            <span>Quản lý kho</span>
                        </a>

                        <a href="@Url.Action("Index", "Thuoc")" class="nav-link">
                            <i class="fa-solid fa-capsules"></i>
                            <span>Danh mục thuốc</span>
                        </a>

                        <a href="@Url.Action("Index", "KiemKe")" class="nav-link">
                            <i class="fa-solid fa-clipboard-check"></i>
                            <span>Kiểm kê tồn kho</span>
                        </a>
                        <a href="@Url.Action("Index", "NhaCungCap")" class="nav-link">
                            <i class="fa-solid fa-truck-field"></i>
                            <span>Quản lý nhà cung cấp</span>
                        </a>

                        <a href="#" class="nav-link">
                            <i class="fa-solid fa-cart-shopping"></i>
                            <span>Bán hàng</span>
                        </a>

                        <a href="@Url.Action("Index", "QuanLyDonHang")" class="nav-link">
                            <i class="fa-solid fa-receipt"></i>
                            <span>Đơn hàng</span>
                        </a>

                        <a href="@Url.Action("Index", "NhapHang")" class="nav-link">
                            <i class="fa-solid fa-truck-ramp-box"></i>
                            <span>Nhập hàng</span>
                        </a>

                        <a href="#" class="nav-link">
                            <i class="fa-solid fa-chart-column"></i>
                            <span>Báo cáo</span>
                        </a>

                    </nav>

                </a>
                <a href="@Url.Action("Index", "TaiKhoan")" class="nav-link">
                    <i class="fa-solid fa-users-gear"></i> Tài khoản &amp; phân quyền
                </a>
                <hr class="text-secondary my-2 mx-3">
                <a href="@Url.Action("LogOut", "Login")" class="nav-link nav-link-logout">
                    <i class="fa-solid fa-right-from-bracket"></i> Đăng xuất
                </a>
            </nav>
        </aside>

        <!-- Khung Nội Dung Chính -->
        <main class="main-wrapper">
            @RenderBody()
        </main>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>