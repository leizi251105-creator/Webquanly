
@{
    Layout = null;
    ViewBag.Title = "Đăng nhập - MỘC BREW";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Đăng nhập | MỘC BREW</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"
          rel="stylesheet" />

    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Roboto:wght@400;500;700&display=swap"
          rel="stylesheet" />

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            font-family: 'Roboto', sans-serif;
            background: #f4eee5;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 25px;
        }

        .login-container {
            width: 100%;
            max-width: 1050px;
            min-height: 620px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            background: #fff;
            border-radius: 22px;
            overflow: hidden;
            box-shadow: 0 20px 60px rgba(61, 39, 26, 0.15);
        }

        .login-banner {
            background: linear-gradient( rgba(40, 25, 17, 0.55), rgba(40, 25, 17, 0.75) ), url('https://images.unsplash.com/photo-1442512595331-e89e73853f31?auto=format&fit=crop&w=1200&q=85');
            background-size: cover;
            background-position: center;
            color: white;
            padding: 65px 50px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .brand {
            font-family: 'Playfair Display', serif;
            font-size: 38px;
            font-weight: 700;
            letter-spacing: 3px;
        }

        .banner-content h2 {
            font-family: 'Playfair Display', serif;
            font-size: 36px;
            line-height: 1.4;
            margin-bottom: 20px;
        }

        .banner-content p {
            font-size: 15px;
            line-height: 1.8;
            color: #eee2d5;
        }

        .banner-footer {
            font-size: 12px;
            color: #e5d7c9;
            letter-spacing: 1px;
        }

        .login-form-section {
            padding: 65px 55px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .login-title {
            font-family: 'Playfair Display', serif;
            color: #4b2e20;
            font-size: 32px;
            font-weight: 700;
        }

        .login-description {
            color: #8c8179;
            font-size: 14px;
            margin-top: 10px;
            margin-bottom: 35px;
        }

        .form-label {
            color: #4b392e;
            font-size: 14px;
            font-weight: 600;
            margin-bottom: 9px;
        }

        .input-group {
            border: 1px solid #e4d9cf;
            border-radius: 10px;
            overflow: hidden;
            background: #fcfaf8;
        }

        .input-group-text {
            background: transparent;
            border: none;
            color: #94735e;
            padding-left: 16px;
        }

        .form-control {
            border: none;
            background: transparent;
            padding: 13px 12px;
            font-size: 14px;
            box-shadow: none !important;
        }

        .input-group:focus-within {
            border-color: #8b5e43;
            box-shadow: 0 0 0 3px rgba(139, 94, 67, 0.1);
        }

        .password-toggle {
            border: none;
            background: transparent;
            color: #94735e;
            padding: 0 15px;
        }

        .btn-login {
            width: 100%;
            background: #68432f;
            border: none;
            border-radius: 10px;
            color: white;
            padding: 14px;
            font-weight: 700;
            font-size: 15px;
            margin-top: 15px;
            transition: 0.25s;
        }

            .btn-login:hover {
                background: #4b2e20;
                color: white;
                transform: translateY(-2px);
            }

        .login-note {
            margin-top: 30px;
            text-align: center;
            color: #a69a90;
            font-size: 12px;
        }

        @@media (max-width: 768px) {
            .login-container {
                grid-template-columns: 1fr;
            }

            .login-banner {
                min-height: 230px;
                padding: 30px;
            }

            .banner-content h2 {
                font-size: 25px;
                margin-top: 30px;
            }

            .banner-footer {
                display: none;
            }

            .login-form-section {
                padding: 40px 28px;
            }
        }
    </style>
</head>

<body>

    <div class="login-container">

        <!-- BÊN TRÁI: HÌNH ẢNH THƯƠNG HIỆU -->
        <div class="login-banner">

            <div class="brand">
                <i class="fa-solid fa-mug-hot me-2"></i>
                MỘC BREW
            </div>

            <div class="banner-content">
                <h2>Hương vị nguyên bản.<br />Trải nghiệm tinh tế.</h2>

                <p>
                    Chào mừng bạn đến với hệ thống quản lý MỘC BREW.
                    Nơi kết nối con người, chất lượng và những trải nghiệm
                    cà phê đầy cảm hứng.
                </p>
            </div>

            <div class="banner-footer">
                © 2026 MỘC BREW MANAGEMENT SYSTEM
            </div>

        </div>

        <!-- BÊN PHẢI: FORM ĐĂNG NHẬP -->
        <div class="login-form-section">

            <div class="mb-4">
                <div class="login-title">Đăng nhập</div>

                <div class="login-description">
                    Vui lòng nhập thông tin tài khoản để tiếp tục.
                </div>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger">
                    <i class="fa-solid fa-circle-exclamation me-2"></i>
                    @ViewBag.Error
                </div>
            }

            @using (Html.BeginForm(
                "Login",
                "MocBrewAuth",
                FormMethod.Post,
                new { autocomplete = "off" }))
            {
                @Html.AntiForgeryToken()

                <div class="mb-4">

                    <label class="form-label">Tên đăng nhập</label>

                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="fa-solid fa-user"></i>
                        </span>

                        <input type="text"
                               name="username"
                               class="form-control"
                               placeholder="Nhập tên đăng nhập"
                               maxlength="50"
                               autocomplete="username"
                               required />
                    </div>

                </div>

                <div class="mb-3">

                    <label class="form-label">Mật khẩu</label>

                    <div class="input-group">

                        <span class="input-group-text">
                            <i class="fa-solid fa-lock"></i>
                        </span>

                        <input type="password"
                               name="password"
                               id="password"
                               class="form-control"
                               placeholder="Nhập mật khẩu"
                               autocomplete="current-password"
                               required />

                        <button type="button"
                                class="password-toggle"
                                onclick="togglePassword()">
                            <i class="fa-solid fa-eye" id="eyeIcon"></i>
                        </button>

                    </div>

                </div>

                <button type="submit" class="btn btn-login">
                    ĐĂNG NHẬP
                    <i class="fa-solid fa-arrow-right-to-bracket ms-2"></i>
                </button>
            }

            <div class="login-note">
                <i class="fa-solid fa-shield-halved me-1"></i>
                Hệ thống quản lý nội bộ MỘC BREW
            </div>

        </div>

    </div>

    <script>function togglePassword() {
            var password = document.getElementById("password");
            var icon = document.getElementById("eyeIcon");

            if (password.type === "password") {
                password.type = "text";
                icon.classList.remove("fa-eye");
                icon.classList.add("fa-eye-slash");
            } else {
                password.type = "password";
                icon.classList.remove("fa-eye-slash");
                icon.classList.add("fa-eye");
            }
        }</script>

</body>
</html>
