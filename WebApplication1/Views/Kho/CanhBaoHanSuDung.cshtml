
@using System
@using System.Linq
@using System.Collections.Generic
@model IEnumerable<WebApplication1.Models.LoThuoc>

@{
    ViewBag.Title = "Cảnh báo hạn sử dụng";
    Layout = "~/Views/Shared/_Layout.cshtml";

    int ngayCanhBao = ViewBag.NgayCanhBao == null
        ? 30 : (int)ViewBag.NgayCanhBao;

    int soLoDaHetHan = ViewBag.SoLoDaHetHan == null
        ? 0 : (int)ViewBag.SoLoDaHetHan;

    int soLoSapHetHan = ViewBag.SoLoSapHetHan == null
        ? 0 : (int)ViewBag.SoLoSapHetHan;

    int soLoNgungHoatDong = ViewBag.SoLoNgungHoatDong == null
        ? 0 : (int)ViewBag.SoLoNgungHoatDong;

    var danhSachLo = Model ?? new List<WebApplication1.Models.LoThuoc>();
}

<style>
    .expiry-page {
        padding: 25px;
        min-height: calc(100vh - 80px);
        background: #f5f7fb;
    }

    .expiry-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
        margin-bottom: 24px;
    }

        .expiry-heading h2 {
            margin: 0 0 8px;
            color: #1f2937;
            font-size: 27px;
            font-weight: 700;
        }

        .expiry-heading p {
            margin: 0;
            color: #6b7280;
        }

    .expiry-back {
        display: inline-block;
        padding: 10px 15px;
        border-radius: 8px;
        background: white;
        border: 1px solid #d1d5db;
        color: #374151;
        text-decoration: none;
    }

        .expiry-back:hover {
            background: #f3f4f6;
            color: #111827;
        }

    .expiry-stats {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
        margin-bottom: 25px;
    }

    .expiry-stat {
        padding: 20px;
        border-radius: 12px;
        background: white;
        border: 1px solid #e5e7eb;
        box-shadow: 0 3px 10px rgba(0,0,0,.04);
    }

        .expiry-stat .label {
            color: #6b7280;
            font-size: 14px;
            margin-bottom: 10px;
        }

        .expiry-stat .value {
            font-size: 28px;
            font-weight: 700;
        }

        .expiry-stat .hint {
            margin-top: 7px;
            color: #6b7280;
            font-size: 12px;
        }

    .expiry-danger {
        color: #dc2626;
    }

    .expiry-warning {
        color: #d97706;
    }

    .expiry-neutral {
        color: #4f46e5;
    }

    .expiry-panel {
        padding: 20px;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        background: white;
        box-shadow: 0 3px 10px rgba(0,0,0,.04);
    }

    .expiry-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 14px;
        margin-bottom: 18px;
    }

        .expiry-toolbar h3 {
            margin: 0;
            color: #1f2937;
            font-size: 19px;
            font-weight: 700;
        }

    .expiry-filter {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
    }

        .expiry-filter a {
            display: inline-block;
            padding: 8px 12px;
            border: 1px solid #d1d5db;
            border-radius: 7px;
            color: #374151;
            background: white;
            text-decoration: none;
        }

            .expiry-filter a.active {
                background: #1d4ed8;
                border-color: #1d4ed8;
                color: white;
            }

    .expiry-search {
        width: 100%;
        max-width: 350px;
        padding: 10px 12px;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        outline: none;
    }

        .expiry-search:focus {
            border-color: #60a5fa;
            box-shadow: 0 0 0 3px rgba(59,130,246,.12);
        }

    .expiry-table-wrap {
        overflow-x: auto;
    }

    .expiry-table {
        width: 100%;
        min-width: 950px;
        border-collapse: collapse;
    }

        .expiry-table th {
            padding: 13px 12px;
            background: #f9fafb;
            color: #4b5563;
            font-size: 13px;
            text-align: left;
            white-space: nowrap;
            border-bottom: 1px solid #e5e7eb;
        }

        .expiry-table td {
            padding: 14px 12px;
            border-bottom: 1px solid #e5e7eb;
            color: #374151;
            vertical-align: middle;
        }

        .expiry-table tbody tr:hover {
            background: #f9fafb;
        }

    .expiry-medicine {
        font-weight: 600;
        color: #111827;
    }

    .expiry-muted {
        display: block;
        margin-top: 4px;
        color: #6b7280;
        font-size: 12px;
    }

    .expiry-badge {
        display: inline-block;
        padding: 5px 9px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
    }

    .badge-expired {
        background: #fee2e2;
        color: #b91c1c;
    }

    .badge-urgent {
        background: #ffedd5;
        color: #c2410c;
    }

    .badge-warning {
        background: #fef3c7;
        color: #92400e;
    }

    .badge-safe {
        background: #dcfce7;
        color: #166534;
    }

    .badge-disabled {
        background: #e5e7eb;
        color: #4b5563;
    }

    .expiry-empty {
        padding: 35px 15px !important;
        text-align: center;
        color: #6b7280 !important;
    }

    .expiry-note {
        margin-top: 18px;
        padding: 14px 16px;
        border-radius: 9px;
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        color: #1e40af;
        font-size: 13px;
        line-height: 1.6;
    }

    @@media (max-width: 768px) {
        .expiry-page {
            padding: 15px;
        }

        .expiry-stats {
            grid-template-columns: 1fr;
        }

        .expiry-panel {
            padding: 13px;
        }
    }
</style>

<div class="expiry-page">

    <div class="expiry-heading">
        <div>
            <h2>Cảnh báo hạn sử dụng</h2>
            <p>Theo dõi hạn dùng và số lượng còn lại của từng lô thuốc.</p>
        </div>

        <a href="@Url.Action("Index", "Kho")" class="expiry-back">
            ← Quay lại quản lý kho
        </a>
    </div>

    <div class="expiry-stats">
        <div class="expiry-stat">
            <div class="label">Lô thuốc đã hết hạn</div>
            <div class="value expiry-danger">@soLoDaHetHan</div>
            <div class="hint">Các lô còn hàng nhưng đã quá hạn sử dụng</div>
        </div>

        <div class="expiry-stat">
            <div class="label">Lô sắp hết hạn</div>
            <div class="value expiry-warning">@soLoSapHetHan</div>
            <div class="hint">Trong vòng @ngayCanhBao ngày được chọn</div>
        </div>

        <div class="expiry-stat">
            <div class="label">Lô ngừng hoạt động</div>
            <div class="value expiry-neutral">@soLoNgungHoatDong</div>
            <div class="hint">Lô còn số lượng nhưng đang ngừng hoạt động</div>
        </div>
    </div>

    <div class="expiry-panel">

        <div class="expiry-toolbar">
            <h3>Danh sách lô thuốc</h3>

            <div class="expiry-filter">
                <a href="@Url.Action("CanhBaoHanSuDung", "Kho", new { ngayCanhBao = 30 })"
                   class="@(ngayCanhBao == 30 ? "active" : "")">30 ngày</a>

                <a href="@Url.Action("CanhBaoHanSuDung", "Kho", new { ngayCanhBao = 60 })"
                   class="@(ngayCanhBao == 60 ? "active" : "")">60 ngày</a>

                <a href="@Url.Action("CanhBaoHanSuDung", "Kho", new { ngayCanhBao = 90 })"
                   class="@(ngayCanhBao == 90 ? "active" : "")">90 ngày</a>
            </div>
        </div>

        <div style="margin-bottom:16px;">
            <input type="text"
                   id="expirySearch"
                   class="expiry-search"
                   placeholder="Tìm theo tên thuốc, mã lô hoặc số lô..." />
        </div>

        <div class="expiry-table-wrap">
            <table class="expiry-table" id="expiryTable">
                <thead>
                    <tr>
                        <th>Mã lô</th>
                        <th>Tên thuốc</th>
                        <th>Số lô</th>
                        <th>Ngày sản xuất</th>
                        <th>Hạn sử dụng</th>
                        <th>Còn lại</th>
                        <th>Số lượng</th>
                        <th>Trạng thái</th>
                    </tr>
                </thead>

                <tbody>
                    @if (danhSachLo.Any())
                    {
                        foreach (var lo in danhSachLo)
                        {
                            int soNgay = (lo.HanSuDung.Date - DateTime.Today).Days;
                            string trangThai;
                            string badgeClass;

                            if (lo.TrangThai != true)
                            {
                                trangThai = "Ngừng hoạt động";
                                badgeClass = "badge-disabled";
                            }
                            else if (soNgay < 0)
                            {
                                trangThai = "Đã hết hạn";
                                badgeClass = "badge-expired";
                            }
                            else if (soNgay <= 30)
                            {
                                trangThai = "Sắp hết hạn";
                                badgeClass = "badge-urgent";
                            }
                            else if (soNgay <= 90)
                            {
                                trangThai = "Gần hết hạn";
                                badgeClass = "badge-warning";
                            }
                            else
                            {
                                trangThai = "Còn hạn";
                                badgeClass = "badge-safe";
                            }

                            <tr>
                                <td>@lo.MaLo</td>
                                <td>
                                    <span class="expiry-medicine">
                                        @(lo.Thuoc != null
                                            ? lo.Thuoc.TenThuoc
                                            : "Không xác định")
                                    </span>
                                </td>
                                <td>@lo.SoLo</td>
                                <td>
                                    @(lo.NgaySanXuat.HasValue
                                        ? lo.NgaySanXuat.Value.ToString("dd/MM/yyyy")
                                        : "Chưa cập nhật")
                                </td>
                                <td>@lo.HanSuDung.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @if (soNgay < 0)
                                    {
                                        <span class="expiry-badge badge-expired">
                                            Quá @Math.Abs(soNgay) ngày
                                        </span>
                                    }
                                    else if (soNgay == 0)
                                    {
                                        <span class="expiry-badge badge-urgent">
                                            Hết hạn hôm nay
                                        </span>
                                    }
                                    else
                                    {
                                        <span>@soNgay ngày</span>
                                    }
                                </td>
                                <td>@lo.SoLuong</td>
                                <td>
                                    <span class="expiry-badge @badgeClass">
                                        @trangThai
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="expiry-empty">
                                Không có lô thuốc nào còn số lượng.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="expiry-note">
            <strong>Lưu ý:</strong> Các mốc 30, 60 và 90 ngày tính từ ngày hiện tại.
            Lô đã hết hạn cần được kiểm tra và xử lý theo quy trình của nhà thuốc.
            Không xuất bán thuốc đã hết hạn.
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        var searchInput = document.getElementById("expirySearch");
        var table = document.getElementById("expiryTable");

        if (!searchInput || !table) return;

        searchInput.addEventListener("input", function () {
            var keyword = this.value.toLowerCase().trim();
            var rows = table.querySelectorAll("tbody tr");

            rows.forEach(function (row) {
                row.style.display =
                    row.innerText.toLowerCase().includes(keyword)
                        ? ""
                        : "none";
            });
        });
    });
</script>
