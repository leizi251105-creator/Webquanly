@using System
@using System.Collections.Generic
@{
    ViewBag.Title = "Quản lý kho";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string hoTen = Session["fullName"] == null
        ? (Session["username"] == null
            ? "Nhân viên kho"
            : Session["username"].ToString())
        : Session["fullName"].ToString();

    int tongSoMatHang = ViewBag.TongSoMatHang == null
        ? 0 : (int)ViewBag.TongSoMatHang;

    int thuocTonKhoThap = ViewBag.ThuocTonKhoThap == null
        ? 0 : (int)ViewBag.ThuocTonKhoThap;

    int? thuocSapHetHan = ViewBag.ThuocSapHetHan == null
        ? (int?)null : (int)ViewBag.ThuocSapHetHan;
    var danhSachLoThuoc =
    ViewBag.DanhSachLoThuoc
    as List<WebApplication1.Models.LoThuoc>
    ?? new List<WebApplication1.Models.LoThuoc>();

    int tongSoLuongTheoLo = ViewBag.TongSoLuongTheoLo == null
        ? 0 : (int)ViewBag.TongSoLuongTheoLo;
}

<style>
    .warehouse-page {
        padding: 25px;
        background: #f5f7fb;
        min-height: calc(100vh - 80px);
    }

    .warehouse-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
        margin-bottom: 25px;
    }

        .warehouse-heading h2 {
            color: #1f2937;
            font-size: 27px;
            font-weight: 700;
            margin: 0 0 8px;
        }

        .warehouse-heading p {
            color: #6b7280;
            margin: 0;
        }

    .warehouse-user {
        background: #dbeafe;
        color: #1d4ed8;
        padding: 10px 15px;
        border-radius: 10px;
        font-weight: 600;
    }

    .warehouse-stats {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 18px;
        margin-bottom: 28px;
    }

    .warehouse-stat {
        background: white;
        border-radius: 12px;
        padding: 22px;
        border: 1px solid #e5e7eb;
        box-shadow: 0 3px 10px rgba(0,0,0,.04);
    }

        .warehouse-stat .label {
            color: #6b7280;
            font-size: 14px;
            margin-bottom: 12px;
        }

        .warehouse-stat .value {
            color: #1d4ed8;
            font-size: 25px;
            font-weight: 700;
        }

        .warehouse-stat .hint {
            color: #6b7280;
            font-size: 12px;
            margin-top: 8px;
        }

    .warehouse-section-title {
        font-size: 20px;
        font-weight: 700;
        color: #1f2937;
        margin: 0 0 16px;
    }

    .warehouse-functions {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
    }

    .warehouse-function {
        display: flex;
        gap: 16px;
        align-items: flex-start;
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 22px;
        box-shadow: 0 3px 10px rgba(0,0,0,.04);
        color: inherit;
        text-decoration: none;
        transition: .2s;
    }

        .warehouse-function:hover {
            border-color: #93c5fd;
            box-shadow: 0 6px 16px rgba(0,0,0,.07);
            transform: translateY(-2px);
        }

    .warehouse-icon {
        width: 48px;
        height: 48px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: #dbeafe;
        font-size: 23px;
    }

    .warehouse-function h4 {
        margin: 2px 0 8px;
        font-size: 16px;
        font-weight: 700;
        color: #1f2937;
    }

    .warehouse-function p {
        margin: 0;
        color: #6b7280;
        font-size: 14px;
        line-height: 1.6;
    }

    .warehouse-notice {
        margin-top: 22px;
        padding: 15px 18px;
        border-radius: 10px;
        background: #eff6ff;
        color: #1e40af;
        border: 1px solid #bfdbfe;
        line-height: 1.6;
    }

    @@media (max-width: 1100px) {
        .warehouse-stats {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 768px) {
        .warehouse-stats,
        .warehouse-functions {
            grid-template-columns: 1fr;
        }

        .warehouse-page {
            padding: 15px;
        }
    }
</style>

<div class="warehouse-page">

    <div class="warehouse-heading">
        <div>
            <h2>Quản lý kho</h2>
            <p>Theo dõi tồn kho và quản lý tình trạng thuốc trong quầy.</p>
        </div>

        <div class="warehouse-user">
            Xin chào, @hoTen
        </div>
    </div>

    <div class="warehouse-stats">
        <div class="warehouse-stat">
            <div class="label">Tổng số mặt hàng đang kinh doanh</div>
            <div class="value">@tongSoMatHang</div>
            <div class="hint">Số loại thuốc đang hoạt động</div>
        </div>

        <div class="warehouse-stat">
            <div class="label">Thuốc sắp hết hạn</div>
            <div class="value">
                @(thuocSapHetHan.HasValue
                    ? thuocSapHetHan.Value.ToString()
                    : "Chưa có dữ liệu")
            </div>
            <div class="hint">Số lô còn hàng, hết hạn trong vòng 90 ngày tới</div>
        </div>
        <div class="warehouse-stat">
            <div class="label">Tổng số lượng thuốc trong lô còn hàng</div>
            <div class="value">@tongSoLuongTheoLo</div>
            <div class="hint">Tổng số lượng của các lô đang hoạt động</div>
        </div>
        <div class="warehouse-stat">
            <div class="label">Thuốc tồn kho thấp</div>
            <div class="value">@thuocTonKhoThap</div>
            <div class="hint">Số loại thuốc có tồn kho không vượt mức tối thiểu</div>
        </div>
    </div>

    <h3 class="warehouse-section-title">Theo dõi chi tiết lô thuốc</h3>

    <div style="background:white; border:1px solid #e5e7eb;
            border-radius:12px; padding:18px;
            margin-bottom:28px; overflow-x:auto;">

        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Mã lô</th>
                    <th>Tên thuốc</th>
                    <th>Số lô</th>
                    <th>Ngày sản xuất</th>
                    <th>Hạn sử dụng</th>
                    <th>Số lượng</th>
                    <th>Trạng thái</th>
                </tr>
            </thead>
            <tbody>
                @if (danhSachLoThuoc.Any())
                {
                    foreach (var lo in danhSachLoThuoc)
                    {
                        var ngayHienTai = DateTime.Today;
                        var soNgayConLai = (lo.HanSuDung.Date - ngayHienTai).Days;

                        <tr>
                            <td>@lo.MaLo</td>
                            <td>
                                @(lo.Thuoc != null
                                ? lo.Thuoc.TenThuoc
                                : "Không xác định")
                            </td>
                            <td>@lo.SoLo</td>
                            <td>
                                @(lo.NgaySanXuat.HasValue
                                ? lo.NgaySanXuat.Value.ToString("dd/MM/yyyy")
                                : "Chưa cập nhật")
                            </td>
                            <td>@lo.HanSuDung.ToString("dd/MM/yyyy")</td>
                            <td>@lo.SoLuong</td>
                            <td>
                                @if (lo.TrangThai != true)
                                {
                                    <span class="badge bg-secondary">
                                        Ngừng hoạt động
                                    </span>
                                }
                                else if (soNgayConLai < 0)
                                {
                                    <span class="badge bg-danger">
                                        Đã hết hạn
                                    </span>
                                }
                                else if (soNgayConLai <= 30)
                                {
                                    <span class="badge bg-danger">
                                        Sắp hết hạn
                                    </span>
                                }
                                else if (soNgayConLai <= 90)
                                {
                                    <span class="badge bg-warning text-dark">
                                        Gần hết hạn
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success">
                                        Còn hạn
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">
                            Chưa có lô thuốc còn hàng.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <h3 class="warehouse-section-title">Chức năng kho</h3>

    @{
        var danhSachThuocTonKhoThap =
            ViewBag.DanhSachThuocTonKhoThap
            as List<WebApplication1.Models.Thuoc>
            ?? new List<WebApplication1.Models.Thuoc>();
    }

    <h3 class="warehouse-section-title">
        Cảnh báo thuốc tồn kho thấp
    </h3>

    <div style="background:white; border:1px solid #e5e7eb;
            border-radius:12px; padding:18px;
            margin-bottom:28px; overflow-x:auto;">

        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Mã thuốc</th>
                    <th>Tên thuốc</th>
                    <th>Đơn vị tính</th>
                    <th>Tồn kho</th>
                    <th>Mức tồn tối thiểu</th>
                    <th>Số lượng cần bổ sung</th>
                </tr>
            </thead>
            <tbody>
                @if (danhSachThuocTonKhoThap.Any())
                {
                    foreach (var thuoc in danhSachThuocTonKhoThap)
                    {
                        int soLuongCanBoSung = Math.Max(
                            0,
                            thuoc.MucTonToiThieu - thuoc.SoLuongTon
                        );

                        <tr>
                            <td>@thuoc.MaThuoc</td>
                            <td>@thuoc.TenThuoc</td>
                            <td>@thuoc.DonViTinh</td>
                            <td>
                                <span class="badge bg-danger">
                                    @thuoc.SoLuongTon
                                </span>
                            </td>
                            <td>@thuoc.MucTonToiThieu</td>
                            <td>
                                <strong>@soLuongCanBoSung</strong>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6"
                            class="text-center text-muted py-4">
                            Không có thuốc nào đang ở mức tồn kho thấp.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>


    <div class="warehouse-functions">

        <a href="@Url.Action("Index", "Thuoc")"
           class="warehouse-function">
            <div class="warehouse-icon">💊</div>
            <div>
                <h4>Danh mục thuốc</h4>
                <p>Tra cứu, thêm mới, cập nhật thông tin và theo dõi trạng thái kinh doanh của thuốc.</p>
            </div>
        </a>

        <a href="@Url.Action("TheoDoiTonKho", "Kho")"
           class="warehouse-function">
            <div class="warehouse-icon">📦</div>
            <div>
                <h4>Theo dõi tồn kho</h4>
                <p>Xem số lượng tồn, mức tồn tối thiểu và nhận biết các mặt hàng cần bổ sung.</p>
            </div>
        </a>

        <a href="@Url.Action("Index", "NhapHang")"
           class="warehouse-function">
            <div class="warehouse-icon">📥</div>
            <div>
                <h4>Nhập thuốc</h4>
                <p>Tạo phiếu nhập, quản lý nhà cung cấp và theo dõi chi tiết từng lô thuốc.</p>
            </div>
        </a>


        <a href="@Url.Action("Index", "CanhBao")"
           class="warehouse-function">

            <div class="warehouse-icon">⏰</div>

            <div>
                <h4>Cảnh báo hạn sử dụng</h4>
                <p>
                    Xem các lô thuốc đã hết hạn, sắp hết hạn
                    và theo dõi hạn sử dụng trong 30, 60 hoặc 90 ngày.
                </p>
            </div>

        </a>

    </div>

    <div class="warehouse-notice">
        <strong>Thông tin:</strong>
        Dữ liệu tồn kho và hạn sử dụng được lấy trực tiếp từ
        cơ sở dữ liệu SQL Server. Hệ thống theo dõi số lượng thuốc,
        tình trạng từng lô và cảnh báo các lô thuốc sắp hết hạn
        hoặc đã hết hạn.
    </div>

</div>
